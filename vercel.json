{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "crons": [
    { "path": "/api/cron/daily-backup", "schedule": "15 2 * * *" }
  ],
  "routes": [
    { "src": "/install-securityshoop-plugin-v3.ps1", "dest": "/api/index.js" },
    { "src": "/install-securityshoop-plugin-v2.ps1", "dest": "/api/index.js" },
    { "src": "/install-securityshoop-plugin.ps1", "dest": "/api/index.js" },
    { "src": "/install-plugin.ps1", "dest": "/api/index.js" },
    { "src": "/securityshoop-plugin.zip", "dest": "/api/index.js" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*\\.(?:html|css|js|ps1|zip|png|jpg|jpeg|gif|svg|ico|webp|mp4|webm|woff|woff2|ttf))", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
